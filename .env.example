# Copy to .env and change every secret. Never commit .env.

# Used only on the very first start, to create the "admin" account. Change it later in the app.
ATT_ADMIN_PASSWORD=change-me-long-random-admin-password
ATT_ADMIN_EMAIL=            # where the admin's forgot-password code is sent

TZ=Asia/Kuala_Lumpur
ATT_PORT=8000
ATT_UID=1000   # output of: id -u
ATT_GID=1000   # output of: id -g
ATT_LOGIN_HOURS=12

# Automatic backups into data/backups (0 hours = off). ATT_BACKUP_COPY_DIR: an optional second place for
# every backup, e.g. a mounted USB drive or network share, so one broken disk cannot lose everything.
ATT_BACKUP_HOURS=24
ATT_BACKUP_KEEP=30
ATT_BACKUP_COPY_DIR=

# Forgot password for teachers and admin. Without ATT_SMTP_HOST the 6-digit code is printed in the server
# console instead of emailed. (Students get their code from a teacher.)
ATT_RESET_MINUTES=30
ATT_SMTP_HOST=             # e.g. smtp.gmail.com
ATT_SMTP_PORT=587
ATT_SMTP_USER=
ATT_SMTP_PASSWORD=         # for Gmail, an App Password
ATT_SMTP_FROM=
ATT_SMTP_SSL=false         # true for port 465
